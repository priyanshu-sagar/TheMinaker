# ==========================================
# TheMinaker - Production Environment Variables
# ==========================================

NODE_ENV=production

# --- Next.js Frontend ---
NEXT_PUBLIC_API_URL=https://api.theminaker.in
NEXT_PUBLIC_WS_URL=wss://mqtt.theminaker.in

# --- NestJS Backend API ---
APP_PORT=3000
CORS_ORIGIN=https://app.theminaker.in

# --- Database & Postgres ---
# Update passwords to strong secure strings!
POSTGRES_DB=minaker_prod
POSTGRES_USER=minaker
POSTGRES_PASSWORD=SECURE_PASSWORD_HERE
POSTGRES_HOST_AUTH_METHOD=md5
POSTGRES_INITDB_ARGS=--auth-host=md5

# --- PgBouncer Variables ---
DATABASES_HOST=postgres
DATABASES_PORT=5432
DATABASES_USER=minaker
DATABASES_PASSWORD=SECURE_PASSWORD_HERE
DATABASES_DBNAME=minaker_prod
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=1000
PGBOUNCER_DEFAULT_POOL_SIZE=25
PGBOUNCER_LOG_CONNECTIONS=0
PGBOUNCER_LOG_DISCONNECTIONS=0

# The API connection string points to PgBouncer internally
DATABASE_URL=postgresql://minaker:SECURE_PASSWORD_HERE@pgbouncer:6432/minaker_prod

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- JWT Secrets ---
JWT_SECRET=generate_a_very_long_random_string_here_for_prod
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=generate_another_random_string_here
JWT_REFRESH_EXPIRES_IN=30d

# --- MQTT ---
MQTT_URL=mqtt://mosquitto:1883
MQTT_USERNAME=minaker_server
MQTT_PASSWORD=SECURE_MQTT_PASSWORD_HERE

# --- AWS / LocalStack (If using real S3, put real keys here) ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=minaker-assets
AWS_S3_ENDPOINT=

# --- MSG91 SMS ---
MSG91_AUTH_KEY=
MSG91_SENDER_ID=MINKRP
MSG91_OTP_TEMPLATE_ID=

# --- Super Admin Account ---
SUPER_ADMIN_EMAIL=admin@theminaker.in
SUPER_ADMIN_PHONE=+919999999999
SUPER_ADMIN_PASSWORD=Admin@12345
