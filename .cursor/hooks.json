{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/wake-agents.js afterFileEdit"
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/wake-agents.js stop",
        "loop_limit": 4
      }
    ],
    "sessionStart": [
      {
        "command": "node .cursor/hooks/wake-agents.js sessionStart"
      }
    ]
  }
}
