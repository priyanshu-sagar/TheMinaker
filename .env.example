# ─────────────────────────────────────────────────────────────────────────────
# TheMinaker — Environment Variables Reference
# Copy this file to .env and fill in real values. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000

# ── Database (via PgBouncer in prod, direct in dev) ──────────────────────────
DATABASE_URL=postgresql://minaker:minaker_secret@localhost:6432/minaker_dev
DB_HOST=localhost
DB_PORT=5432
DB_USER=minaker
DB_PASSWORD=minaker_secret
DB_NAME=minaker_dev
DB_POOL_SIZE=10

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_STRONG_RANDOM_SECRET
JWT_REFRESH_EXPIRES_IN=30d

# ── MQTT (Mosquitto) ──────────────────────────────────────────────────────────
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=minaker_server
MQTT_PASSWORD=REPLACE_WITH_MQTT_PASSWORD

# ── Firebase Cloud Messaging (FCM) ───────────────────────────────────────────
FIREBASE_PROJECT_ID=REPLACE_WITH_FIREBASE_PROJECT_ID
FIREBASE_PRIVATE_KEY=REPLACE_WITH_FIREBASE_PRIVATE_KEY
FIREBASE_CLIENT_EMAIL=REPLACE_WITH_FIREBASE_CLIENT_EMAIL

# ── MSG91 (TRAI DLT compliant SMS — India) ───────────────────────────────────
MSG91_AUTH_KEY=REPLACE_WITH_MSG91_AUTH_KEY
MSG91_SENDER_ID=MINKRP
MSG91_OTP_TEMPLATE_ID=REPLACE_WITH_DLT_TEMPLATE_ID

# ── AWS S3 / LocalStack (dev uses LocalStack) ────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_S3_BUCKET=minaker-assets
AWS_S3_ENDPOINT=http://localhost:4566   # Remove in prod (uses real AWS)

# ── Mapbox (for web dashboard live map) ──────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=REPLACE_WITH_MAPBOX_PUBLIC_TOKEN

# ── Web Dashboard URL ────────────────────────────────────────────────────────
WEB_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000

# ── CORS (comma-separated allowed origins) ───────────────────────────────────
CORS_ORIGIN=http://localhost:3001,http://localhost:3002

# ── Super Admin Bootstrap ────────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@theminaker.in
SUPER_ADMIN_PHONE=+919999999999
SUPER_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
